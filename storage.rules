rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 既有功能：保留原本 students 路徑的存取規則，避免影響同一 Firebase 專案的其他應用。
    match /students/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /signatures/{fileName} {
      // 家長不需登入即可送出；限制為 PNG 且不超過 2 MB。
      // request.resource != null 也會避免未授權刪除既有檔案。
      allow write: if request.resource != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType == 'image/png';
      allow read: if true;
    }
    
    match /consents/{fileName} {
      // 家長不需登入即可送出；只接受 PDF 且不超過 10 MB。
      allow write: if request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      allow read: if true;
    }
  }
}
