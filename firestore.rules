rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /signatures/{document=**} {
      // 允許任何人新增資料，但必須符合格式
      allow create: if isValidSignature(request.resource.data);
      // 禁止修改已存在的資料 (Immutable)
      allow update: if false;
      // 只有驗證過的管理員可以讀取或刪除
      allow read, delete: if request.auth != null;
    }

    function isValidSignature(data) {
      // 必填欄位檢查 (新增 city, school, email)
      let hasRequiredFields = data.keys().hasAll(['city', 'school', 'studentName', 'parentName', 'grade', 'cls', 'seat', 'signatureUrl', 'pdfUrl', 'timestamp']);
      
      // Email 驗證：如果有的話必須是字串，且符合格式 (或是空字串也可以，如果我們允許不填)
      // 但根據 UI 邏輯，我們允許 email 為空字串或未定義(如果沒傳)，但如果有傳必須是字串
      // 這裡簡單起見，我們允許 email 欄位存在，且如果是字串即可
      let emailValid = !('email' in data) || (data.email is string);

      return hasRequiredFields &&
             data.city is string && data.city.size() > 0 &&
             data.school is string && data.school.size() > 0 &&
             data.studentName is string && data.studentName.size() > 0 &&
             data.parentName is string && data.parentName.size() > 0 &&
             data.grade is string && data.grade.matches('^[0-9]+$') &&
             data.cls is string && data.cls.matches('^[0-9]+$') &&
             data.seat is string && data.seat.matches('^[0-9]+$') &&
             data.signatureUrl is string &&
             data.timestamp is timestamp &&
             emailValid;
    }
  }
}
